{
  "name": "andycarlberg.com",
  "private": true,
  "author": "Andy Carlberg <andycarlberg@gmail.com> (https://www.andycarlberg.com/)",
  "description": "The professional profile and technical blog of Digital Strategist Andy Carlberg, built with Astro and hosted on Vercel.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "astro dev",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "biome format --write --error-on-warnings .",
    "check": "biome check --write --error-on-warnings .",
    "drafts:link": "node ./scripts/link-drafts.mjs",
    "drafts:promote": "node ./scripts/promote-draft.mjs",
    "lint:biome": "biome lint .",
    "lint:md": "markdownlint-cli2 --fix \"src/**/*.{md,mdx}\" \"#src/content/drafts/**\"",
    "lint:package-json": "npmPkgJsonLint .",
    "ci:code-quality": "pnpm run check",
    "ci:docs-lint": "pnpm run lint:md",
    "ci:security": "pnpm audit --prod --audit-level high",
    "ci:dep-health": "depcheck --ignore-bin-package=false",
    "ci:license-check": "license-checker --production --onlyAllow 'MIT;ISC;BSD-3-Clause;Apache-2.0;CC0-1.0;MPL-2.0' --excludePackages 'andycarlberg.com'",
    "ci:all": "pnpm run check && pnpm run ci:docs-lint && pnpm run ci:security && pnpm run ci:dep-health && pnpm run ci:license-check",
    "deps:check": "ncu"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,astro,css}": [
      "biome check --write"
    ],
    "*.{md,mdx}": [
      "markdownlint-cli2 --fix"
    ]
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/lucide": "^1.2.140",
    "@iconify-json/simple-icons": "^1.2.99",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.3.5",
    "astro-favicons": "^3.1.8",
    "astro-icon": "^1.2.0",
    "focus-trap": "^8.2.3",
    "katex": "^0.18.9",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-wrap-all": "^1.1.0",
    "remark-math": "^6.0.0",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/language-server": "^2.17.1",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/vercel": "^11.0.11",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "depcheck": "^1.4.7",
    "lefthook": "^2.1.17",
    "license-checker": "^25.0.1",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "npm-check-updates": "^23.1.0",
    "npm-package-json-lint": "^11.0.0",
    "npm-package-json-lint-config-default": "^10.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.0.1",
    "vercel": "^62.2.0",
    "vite": "^8.3.2"
  }
}
